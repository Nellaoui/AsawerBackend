# This folder is mirrored to Nellaoui/AsawerBackend by .github/workflows/sync-backend.yml,
# so anything ignored here is also absent from the deployed backend.
# Only list generated, local, or secret files.

# dependencies
node_modules/

# secrets & local config
.env
.env.*
credentials.json
google-service-account.json
*.pem
*.key

# local database backups
backups/

# logs & runtime
*.log
*.pid
*.seed
*.pid.lock

# test output
coverage/
*.lcov
.nyc_output

# caches
.npm
.eslintcache
.node_repl_history
*.tsbuildinfo

# uploaded files (keep the folder, not its contents)
uploads/*
!uploads/.gitkeep

# editor / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# packaged output
*.tgz
